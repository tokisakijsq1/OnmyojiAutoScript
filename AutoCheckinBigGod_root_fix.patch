+    def _ensure_root_shell(self):
+        """检测并确保 ADB shell 具备 root 权限，返回 'su' / 'direct' / None。
+
+        旧版模拟器（Android 12 的 MuMu 等）通过 su 命令提权；
+        新版 MuMu 6.x（Android 15）系统里没有 su，root 体现为 adbd 的
+        root 模式：执行 adb root 后 adb shell 本身就是 root。
+        """
+        try:
+            out = self._adb_shell(['su', '-c', 'id'], timeout=8)
+            if 'uid=0' in out:
+                return 'su'
+        except Exception:
+            pass
+        try:
+            out = self._adb_shell(['id'], timeout=8)
+            if 'uid=0' in out:
+                return 'direct'
+        except Exception:
+            pass
+        logger.info('无su命令，尝试通过 adb root 切换root模式...')
+        try:
+            self._adb_cmd(['root'], timeout=15)
+        except Exception:
+            pass
+        for _ in range(5):
+            time.sleep(2)
+            try:
+                if self._adb_serial:
+                    self._adb_cmd(['connect', self._adb_serial], timeout=8)
+                out = self._adb_shell(['id'], timeout=8)
+                if 'uid=0' in out:
+                    logger.info('adb 已切换为root模式')
+                    return 'direct'
+            except Exception:
+                pass
+        return None
+
+    def _root_shell(self, cmd_str, timeout=15):
+        """以 root 执行 shell 命令字符串，按 root 模式决定是否加 su 前缀。"""
+        if getattr(self, '_root_mode', None) == 'direct':
+            return self._adb_shell([cmd_str], timeout=timeout)
+        return self._adb_shell([f'su -c "{cmd_str}"'], timeout=timeout)
+
     def _is_frida_server_running(self):
